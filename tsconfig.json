{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@/components/iot/*": ["./registry/immortal/components/*"],
      "@/components/blocks/*": ["./registry/immortal/blocks/*"],
      "@/*": ["./src/*"],
      "@/lib/telemetry": ["./registry/immortal/components/telemetry.ts"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "registry/**/*.ts", "registry/**/*.tsx", "vite.config.ts"]
}
