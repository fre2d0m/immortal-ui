{
  "name": "immortal-ui",
  "description": "Immortal UI — a styled shadcn/ui registry for connected devices, telemetry, and IoT workflows.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-registry.mjs --local && vite",
    "registry:build": "node scripts/build-registry.mjs",
    "build": "npm run registry:build && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4177 --strictPort",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "pretest": "npm run registry:build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.32",
    "postcss-nesting": "14.0.3",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
